.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.DS_Store
data/raw/
# local state and large intermediate outputs (final evidence is exported to runs/, cost/, evals/, grading/)
state/
cost/pilot_state/
*.sqlite
*.sqlite-wal
*.sqlite-shm
runs/*/STOP
local-reference.json
self-check.json
# dashboard: build outputs (dashboard.db is rebuilt by load_db.py and shipped by `vercel deploy`)
dashboard/dashboard.db
dashboard/frontend/node_modules/
dashboard/frontend/dist/
dashboard/.vercel/
# orchestrator: keep the run logs and terminal recording as interruption/resume evidence, not the PID files
runs/_orchestrator/*.pid
state_evals/
dashboard/frontend/tsconfig.tsbuildinfo
# final run: the two large JSONL files are committed as .jsonl.gz (finalize writes them; readers fall back to .gz)
runs/final100k/enriched.jsonl
runs/final100k/records.jsonl
# checkpoints of the memo-only re-runs (invocations 4-8) repeat inv03 record states; run_summary.json records them
runs/final100k/checkpoints/inv0[4-8]_*.json
